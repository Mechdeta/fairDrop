PORT=4000
CORS_ORIGIN=http://localhost:3000

# World ID 4.0 Relying Party Configuration (World Developer Portal)
# Never expose secrets in client-side code or commit them to version control.
WORLD_RP_ID=rp_your_relying_party_id
WORLD_APP_ID=app_your_portal_app_id
WORLD_RP_SIGNING_KEY=0x_your_private_hex_signing_key_from_developer_portal
WORLD_ENVIRONMENT=staging # 'staging', 'production', or 'sandbox'

# Optional: Set to 'true' for local offline testing/CI without live World Portal credentials
WORLD_MOCK_VERIFICATION=false

# Optional PostgreSQL Connection String
# If omitted, FairDrop automatically uses the atomic in-memory repository for local development.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/fairdrop
